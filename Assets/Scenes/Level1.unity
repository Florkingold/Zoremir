  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0417\u043E\u0440\u0435\u043C\u0438\u0440: \u042F  \u043C\u0440\u0456\u044F\u0432
    \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438 \u041F\u0430\u043B\u0430\u0434\u0456\u044E,
    \u0430\u043B\u0435 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u0432\u0456\u0434\u043A\u043B\u0430\u0434\u0430\u0432
    \u0442\u0443 \u043C\u0430\u043D\u0434\u0440\u0456\u0432\u043A\u0443. \u0427\u043E\u0431\u043E\u0442\u0456
    \u043F\u043E\u0440\u0432\u0430\u043B\u0438\u0441\u044F, \u043C\u0430\u044E \u0437\u0440\u043E\u0431\u0438\u0442\u0438
    \u0441\u0442\u0456\u043B \u0441\u0443\u0441\u0456\u0434\u043E\u0432\u0456, \u0445\u0430\u0442\u0430
    \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0454 \u0440\u0435\u043C\u043E\u043D\u0442\u0443...
    \u0422\u0430 \u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u043C\u043E\u0436\u043D\u0430
    \u0447\u0435\u043A\u0430\u0442\u0438? \u041E\u0442 \u0432\u0438\u0439\u0434\u0443
    \u0437\u0430 \u043F\u043E\u0440\u0456\u0433 \u0456 \u043F\u0456\u0434\u0443 \u0441\u043E\u0431\u0456.
    \u0429\u043E \u0431\u0443\u0434\u0435, \u0442\u0435 \u0431\u0443\u0434\u0435."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
